datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id        String   @id @default(cuid())
    name      String?
    email     String?  @unique
    image     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    meals        Meal[]
    workouts     Workout[]
    integrations Integration[]
}

model Workout {
    id          String   @id @default(cuid())
    description String
    date        DateTime @default(now())
    duration    Int? // minutes
    intensity   String? // optional: e.g. "low", "moderate", "high"
    user        User?     @relation(fields: [userId], references: [id])
    userId      String?
    createdAt   DateTime @default(now())
}

model Meal {
    id          String   @id @default(cuid())
    description String
    date        DateTime @default(now())
    calories    Int?
    protein     Float?
    carbs       Float?
    fat         Float?
    user        User?     @relation(fields: [userId], references: [id])
    userId      String?
    createdAt   DateTime @default(now())
}

model Integration {
    id           String    @id @default(cuid())
    provider     String
    status       String    @default("connected")
    lastSync     DateTime?
    accessToken  String?
    refreshToken String?
    expiresAt    DateTime?
    dataScope    String? // e.g. "read:workouts,read:meals"
    user         User      @relation(fields: [userId], references: [id])
    userId       String
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
}
